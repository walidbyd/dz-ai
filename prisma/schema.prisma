generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String       @id @default(uuid())
  name        String?
  email       String       @unique
  password    String?      // Used for Admin access
  role        String       @default("USER") // "USER" or "ADMIN"
  credits     Int          @default(1) // 1 free credit on registration
  currentPack String       @default("FREE_TRIAL")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  generations VideoOrder[]
  orders      Order[]
}

model VideoOrder {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Product & Ad Details
  productName         String
  coreOffer           String?
  videoType           String       // "avatar" (talking person) or "showcase" (product B-roll)
  gender              String?      // "Male", "Female", or null if custom audio used
  productImages       String?      // JSON stringified array of uploaded image paths/URLs
  
  // Audio Source Configuration
  audioSource         String       @default("AI_VOICE") // "AI_VOICE" (ElevenLabs) or "UPLOADED_VOICE" (Direct user MP3)
  uploadedVoiceUrl    String?      // File path/URL of the user's recorded or uploaded audio track
  generatedAudioUrl   String?      // ElevenLabs generated audio URL (if AI_VOICE selected)

  // Prompts & Scripts
  spokenScript        String?      // Algerian Darja text generated by Gemini
  klingVisualPrompt   String?      // Visual prompt generated for Kling 2.6

  // Video Output Artifacts
  silentVideoUrl      String?      // Base video generated by Kling
  finalSyncedVideoUrl String?      // Final output (either lip-synced or merged with user audio via FFmpeg)

  // Order State: "PENDING", "PROCESSING", "COMPLETED", "FAILED"
  status              String       @default("PENDING")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Order {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Package Tier: "PACK_3_NO_VOICE", "PACK_3_VOICE", "PACK_10_NO_VOICE", "PACK_10_VOICE"
  packageType         String       
  amountDzd           Int          // e.g., 2400, 3900, 5400, 8900
  creditsAdded        Int          // 3 or 10
  
  // BaridiMob Information
  paymentMethod       String       @default("BARIDIMOB")
  transactionRef      String?      // Receipt transaction code entered by the user
  receiptUrl          String?      // Path to screenshot upload
  status              String       @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}